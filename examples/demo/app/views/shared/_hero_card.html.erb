<article class="hero-card">
  <header>
    <h1><%= title %></h1>
    <p class="subtitle"><%= subtitle %></p>
  </header>
  <section class="body">
    <p><%= body %></p>
    <ul>
      <li><%= meta.first %></li>
      <li><%= meta.last %></li>
    </ul>
  </section>
  <footer>
    <a href="<%= cta_url %>"><%= cta_label %></a>
  </footer>
</article>
